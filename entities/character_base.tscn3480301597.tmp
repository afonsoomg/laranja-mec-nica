[sub_resource type="GDScript" id="GDScript_is1ha"]
script/source = "extends CharacterBody2D
class_name PlayerCharacter

@onready var stats_component = $Components/StatsComponent
@onready var health_component = $Components/HealthComponent
@onready var hurtbox_component = $Components/HurtboxComponent
@onready var animation_component = $Components/AnimationComponent
@onready var knockback_component = $Components/KnockbackComponent

var is_dead: bool = false

func _ready() -> void:
	if health_component:
		health_component.died.connect(_on_died)

func _on_died() -> void:
	is_dead = true
	if animation_component:
		animation_component.play_death()
"

